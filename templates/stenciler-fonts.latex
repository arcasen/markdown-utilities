% \setmonofont{Google Sans Code}
% \setmonofont{Monaspace Xenon}
\setmonofont{Monaspace Neon}

\makeatletter
\ifdefstring{\stenciler@lang}{zh}{
% 修改默认字体及其粗体
\ifmacosx
  \setCJKmainfont[ 
    % 开启伪斜体，倾斜角度0.15≈8.6度，常用0.15~0.2
    % AutoFakeSlant  = 0.15,  
    ItalicFont = STKaiti,  
    BoldFont   = Noto Sans CJK SC,
  ]{Noto Serif CJK SC}
\else\iflinux
  \setCJKmainfont[
    ItalicFont = FandolKai-Regular,   
    BoldFont   = Noto Sans CJK SC,
  ]{Noto Serif CJK SC}
\fi\fi

% \setCJKsansfont{Noto Sans CJK SC}
% \setCJKmonofont{Sarasa Mono SC} % 默认为仿宋

}{\relax}
\makeatother
